{
  "name": "romanv.dev",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/prepare-sites.mjs",
    "preview": "astro preview",
    "lint": "astro check",
    "resume:en": "node resume/generate.mjs en",
    "resume:ru": "node resume/generate.mjs ru",
    "resume:generate": "npm run resume:en && npm run resume:ru",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"resume/*.{mjs,css}\" astro.config.mjs package.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.3",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.10.1",
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3"
  }
}
